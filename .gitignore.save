# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# MATLAB autosave / backup files
*.asv
*.m~
*.autosave

# MATLAB generated/cache files
*.mex*
*.p
*.slxc
*.mlappinstall
*.mltbx

# Simulink generated folders
slprj/
sccprj/
codegen/
*_grt_rtw/
*_ert_rtw/
*_rtw/

# Simulink cache / generated artifacts
*.slxc
*.slx.r*
*.mdl.r*

# MATLAB project/user-specific files
*.prj.user
*.prefs

# Temporary files
*.tmp
*.bak
*~

# Logs / generated outputs
*.log

# Optional: generated figures/data
